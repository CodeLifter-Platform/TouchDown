@using TD.Services.Telemetry

@if (IsVisible)
{
    <div class="telemetry-consent-overlay">
        <MudPaper Class="telemetry-consent-card" Elevation="8">

            @if (_isPolicyChange)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    Our data policy has changed. Please review and confirm your preference.
                </MudAlert>
            }

            <div class="d-flex align-center gap-3 mb-4">
                <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" GutterBottom="false">Help improve TouchDown</MudText>
            </div>

            <MudText Typo="Typo.body1" Class="mb-4">
                TouchDown is in beta. Agent runs are non-deterministic, so a failure is rarely
                reproducible from a description alone. With your permission, TouchDown records
                <strong>detailed diagnostics</strong> about each Drive so problems can be
                diagnosed from the trace rather than guessed at.
            </MudText>

            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center mb-2 consent-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="consent-section-icon" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Success">What is recorded:</MudText>
                    </div>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">Your task description, and the repository path and branch name</MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">What each agent was asked to do and the output it produced</MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">Errors in full, including messages and stack traces</MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">Drive outcomes, timings, model and effort choices, and cost</MudListItem>
                    </MudList>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <div class="d-flex align-center mb-2 consent-section-label">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Info" Size="Size.Small" Class="consent-section-icon" />
                        <MudText Typo="Typo.subtitle2" Color="Color.Info">Where it goes:</MudText>
                    </div>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small"><strong>Nowhere by default.</strong> Nothing leaves this machine unless an endpoint is configured</MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">If one is configured, data goes only to that destination — you choose it</MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Circle" IconSize="Size.Small">Nothing at all is recorded if you decline</MudListItem>
                    </MudList>
                </MudItem>
            </MudGrid>

            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-4">
                Because diagnostics include your task text, paths and agent output, they may
                contain information about your code. Decline if that is not appropriate for
                the work you do here.
            </MudAlert>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                You can change this at any time in Settings. Revoking takes effect immediately.
            </MudText>

            <MudDivider Class="mb-4" />

            <div class="d-flex justify-end gap-3">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Large"
                           OnClick="DeclineAsync"
                           Disabled="@_saving">
                    Decline
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="AcceptAsync"
                           Disabled="@_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Accept
                </MudButton>
            </div>

        </MudPaper>
    </div>
}

