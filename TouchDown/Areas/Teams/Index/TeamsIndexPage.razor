@page "/teams"
@using TD.MVVM.Components
@inherits ViewComponentBase<TeamsIndexPageVM>
@rendermode InteractiveServer

<PageTitle>TD - Teams</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <div class="d-flex justify-space-between align-center mb-1">
        <MudText Typo="Typo.h5">Agent Teams</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.GroupAdd" OnClick="OpenCreateTeam">
            New Team
        </MudButton>
    </div>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Manage your agent rosters. Each team has a leader, workers, and specialized roles.
    </MudText>

    @if (_creatingTeam)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.subtitle2" Class="mb-3">New team</MudText>
            <MudTextField @bind-Value="_newTeamName" Label="Team name" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" MaxLength="100" Class="mb-3" />
            <MudTextField @bind-Value="_newTeamDescription" Label="Description" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Lines="2" MaxLength="500" Class="mb-3" />
            <div class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Text" OnClick="() => _creatingTeam = false" Disabled="@VM.IsSaving">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTeam"
                           Disabled="@(VM.IsSaving || string.IsNullOrWhiteSpace(_newTeamName))">
                    Create
                </MudButton>
            </div>
        </MudPaper>
    }

    <MudStack Spacing="4">
        @foreach (var team in VM.Teams)
        {
            <MudExpansionPanels Elevation="0" Dense="true">
                <MudExpansionPanel Style="background: var(--mud-palette-surface);">
                    <TitleContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.subtitle1">@team.Name</MudText>
                            @if (team.IsDefault)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Default</MudChip>
                            }
                            <MudSpacer />
                            @if (!team.IsDefault)
                            {
                                <MudTooltip Text="Make this the default team">
                                    <MudIconButton Icon="@Icons.Material.Filled.StarBorder" Size="Size.Small"
                                                   OnClick="@(() => VM.SetDefaultTeam(team))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete this team">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" OnClick="@(() => ConfirmDeleteTeam(team))" />
                                </MudTooltip>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@team.Description</MudText>

                        <MudSimpleTable Dense="true" Hover="true" Class="mb-3">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th>Model</th>
                                    <th>Effort</th>
                                    <th>Fan-out</th>
                                    <th>System Prompt</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in team.Members.OrderBy(m => m.Role))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-center gap-1">
                                                @if (member.IsLeader)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Small" />
                                                }
                                                @member.Name
                                            </div>
                                        </td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@TeamsIndexPageVM.GetRoleColor(member.Role)" Variant="Variant.Outlined">
                                                @member.Role
                                            </MudChip>
                                        </td>
                                        <td>
                                            <MudSelect T="ClaudeModel" Value="member.Model" Dense="true" Margin="Margin.Dense"
                                                       Variant="Variant.Outlined" Style="min-width: 170px;"
                                                       ValueChanged="@(m => VM.SaveMemberModel(member, m))">
                                                @foreach (var cm in Enum.GetValues<ClaudeModel>())
                                                {
                                                    <MudSelectItem T="ClaudeModel" Value="@cm">@cm.ToDisplayName()</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                        <td>
                                            <MudSelect T="AgentEffort" Value="member.Effort" Dense="true" Margin="Margin.Dense"
                                                       Variant="Variant.Outlined" Style="min-width: 130px;"
                                                       ValueChanged="@(e => VM.SaveMemberEffort(member, e))">
                                                @foreach (var eff in Enum.GetValues<AgentEffort>())
                                                {
                                                    <MudSelectItem T="AgentEffort" Value="@eff">@eff.ToDisplayName()</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </td>
                                        <td>
                                            <MudTooltip Text="Maximum parallel instances the Quarterback may fan this agent into.">
                                                <MudNumericField T="int" Value="member.MaxInstances" Min="1" Max="8"
                                                                 Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                 Style="min-width: 90px;"
                                                                 ValueChanged="@(n => VM.SaveMemberMaxInstances(member, n))" />
                                            </MudTooltip>
                                        </td>
                                        <td style="min-width: 340px;">
                                            @if (VM.EditingMemberId == member.Id)
                                            {
                                                <MudTextField @bind-Value="VM.EditBuffer" Variant="Variant.Outlined"
                                                              Lines="6" MaxLength="4000"
                                                              Immediate="true" Class="mb-2" />
                                                <div class="d-flex justify-end gap-2">
                                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                                               OnClick="VM.CancelEdit" Disabled="@VM.IsSaving">
                                                        Cancel
                                                    </MudButton>
                                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.Save" Disabled="@VM.IsSaving"
                                                               OnClick="() => VM.SaveEditCommand.ExecuteAsync(member)">
                                                        @(VM.IsSaving ? "Saving…" : "Save")
                                                    </MudButton>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-start gap-1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                             Style="font-style: italic; white-space: pre-wrap;">@member.SystemPrompt</MudText>
                                                    <MudTooltip Text="Edit prompt">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                                       OnClick="() => VM.BeginEdit(member)" />
                                                    </MudTooltip>
                                                </div>
                                            }
                                        </td>
                                        <td style="width: 48px;">
                                            <MudTooltip Text="Remove this agent">
                                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => VM.RemoveMember(team, member))" />
                                            </MudTooltip>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>

                        @* ── Add member ── *@
                        @if (_addingMemberToTeamId == team.Id)
                        {
                            <MudPaper Outlined="true" Class="pa-3 mb-3">
                                <MudText Typo="Typo.subtitle2" Class="mb-3">Add an agent</MudText>
                                <div class="d-flex gap-2 flex-wrap mb-3">
                                    <MudTextField @bind-Value="_newMemberName" Label="Name" Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Immediate="true" MaxLength="100"
                                                  Style="min-width: 200px;" />
                                    <MudSelect T="AgentRole" @bind-Value="_newMemberRole" Label="Role"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 150px;">
                                        @foreach (var role in Enum.GetValues<AgentRole>())
                                        {
                                            <MudSelectItem T="AgentRole" Value="@role">@role</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSelect T="ClaudeModel" @bind-Value="_newMemberModel" Label="Model"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 170px;">
                                        @foreach (var m in Enum.GetValues<ClaudeModel>())
                                        {
                                            <MudSelectItem T="ClaudeModel" Value="@m">@m.ToDisplayName()</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudSelect T="AgentEffort" @bind-Value="_newMemberEffort" Label="Effort"
                                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 140px;">
                                        @foreach (var e in Enum.GetValues<AgentEffort>())
                                        {
                                            <MudSelectItem T="AgentEffort" Value="@e">@e.ToDisplayName()</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudNumericField T="int" @bind-Value="_newMemberMaxInstances" Label="Fan-out"
                                                     Min="1" Max="8" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     Style="min-width: 110px;" />
                                </div>
                                <MudTextField @bind-Value="_newMemberPrompt" Label="System prompt"
                                              Variant="Variant.Outlined" Lines="4" MaxLength="4000" Class="mb-3"
                                              HelperText="What this agent is and what it is responsible for." />
                                <div class="d-flex justify-end gap-2">
                                    <MudButton Variant="Variant.Text" OnClick="() => _addingMemberToTeamId = null">Cancel</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               Disabled="@string.IsNullOrWhiteSpace(_newMemberName)"
                                               OnClick="@(() => AddMember(team))">
                                        Add
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mb-3"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="@(() => BeginAddMember(team))">
                                Add agent
                            </MudButton>
                        }

                        @if (team.CommunicationRules.Any())
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @foreach (var rule in team.CommunicationRules)
                                {
                                    <MudText Typo="Typo.body2"><strong>@rule.Style</strong> — @rule.Description</MudText>
                                }
                            </MudAlert>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </MudStack>
</MudContainer>

@code {
    [Inject] private IDialogService DialogService { get; set; } = null!;

    private bool _creatingTeam;
    private string _newTeamName = "";
    private string _newTeamDescription = "";

    private int? _addingMemberToTeamId;
    private string _newMemberName = "";
    private AgentRole _newMemberRole = AgentRole.Worker;
    private ClaudeModel _newMemberModel = ClaudeModel.Sonnet;
    private AgentEffort _newMemberEffort = AgentEffort.High;
    private int _newMemberMaxInstances = 1;
    private string _newMemberPrompt = "";

    private void OpenCreateTeam()
    {
        _newTeamName = "";
        _newTeamDescription = "";
        _creatingTeam = true;
    }

    private async Task CreateTeam()
    {
        await VM.CreateTeam(_newTeamName, _newTeamDescription);
        _creatingTeam = false;
    }

    private async Task ConfirmDeleteTeam(AgentTeam team)
    {
        // Deleting a roster is not recoverable from the UI, so confirm first.
        var result = await DialogService.ShowMessageBoxAsync(
            $"Delete {team.Name}?",
            "This removes the team and its agents. Drives that already used it keep their history.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true) await VM.DeleteTeam(team);
    }

    private void BeginAddMember(AgentTeam team)
    {
        _addingMemberToTeamId = team.Id;
        _newMemberName = "";
        _newMemberRole = AgentRole.Worker;
        _newMemberModel = ClaudeModel.Sonnet;
        _newMemberEffort = AgentEffort.High;
        _newMemberMaxInstances = 1;
        _newMemberPrompt = "";
    }

    private async Task AddMember(AgentTeam team)
    {
        await VM.AddMember(team, new AgentMember
        {
            Name = _newMemberName,
            Role = _newMemberRole,
            Model = _newMemberModel,
            Effort = _newMemberEffort,
            MaxInstances = _newMemberMaxInstances,
            SystemPrompt = string.IsNullOrWhiteSpace(_newMemberPrompt) ? null : _newMemberPrompt.Trim(),
        });

        _addingMemberToTeamId = null;
    }
}
